# ---- FalaBrincando — configuração do servidor ----
PORT=3333
NODE_ENV=production

# MySQL da Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO
DB_PASSWORD=SEU_PASSWORD
DB_NAME=falabrincando

# Troque por uma string longa e aleatória
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# URL pública do site (para CORS). Ex.: https://seudominio.com
CORS_ORIGIN=*

# Pasta de uploads (PDFs, imagens, áudios)
UPLOAD_DIR=./storage

# Limite de upload (MB)
UPLOAD_MAX_MB=25